\begin_layout Subsection
Cost of representative risk 
\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
label{sec:cost_rep}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
First we note that identically distributed shocks gives 
\begin_inset Formula $\mathbb{E}\left[u\left(\left(1+\epsilon_{t}\right)\bar{c}\right)\right]=\mathbb{E}\left[u\left(\left(1+\epsilon_{t+k}\right)\bar{c}\right)\right],\,k\geq0$
\end_inset

 implying
\begin_inset Formula 
\begin{align*}
\sum^{\infty}_{t=0}\beta^{t}u\left(\left(1-\lambda_{c}\right)\bar{c}\right) & =\mathbb{E}\left[\sum^{\infty}_{t=0}\beta^{t}u\left(\left(1+\epsilon_{t}\right)\bar{c}\right)\right]\\
 & =\sum^{\infty}_{t=0}\beta^{t}\mathbb{E}\left[u\left(\left(1+\epsilon_{t}\right)\bar{c}\right)\right]\iff\\
u\left(\left(1-\lambda_{c}\right)\bar{c}\right) & =\mathbb{E}\left[u\left(\left(1+\epsilon_{t}\right)\bar{c}\right)\right].
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Using the CRRA utility specification and isolating 
\begin_inset Formula $\lambda$
\end_inset

 this yields
\begin_inset Formula 
\begin{align*}
\mathbb{E}\left[\frac{\left[\left(1+\epsilon_{t}\right)\bar{c}\right]^{1-\gamma}-1}{1-\gamma}\right] & =\frac{\left[\left(1-\lambda\right)\bar{c}\right]^{1-\gamma}-1}{1-\gamma}\iff\\
\mathbb{E}\left[(1+\epsilon_{t})^{1-\gamma}\right] & =\left(1-\lambda\right)^{1-\gamma}\iff\\
\lambda & =1-\left(\mathbb{E}\left[(1+\epsilon_{t})^{1-\gamma}\right]\right)^{1-\gamma}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Using that 
\begin_inset Formula $\epsilon_{t}$
\end_inset

 is uniformely distributed and 
\begin_inset Formula $\epsilon_{t}\in[-\epsilon,\epsilon]$
\end_inset

 we have
\begin_inset Formula 
\begin{align*}
\sigma_{c} & =\frac{1}{\sqrt{12}}\left[\left(1+\epsilon\right)-\left(1-\epsilon\right)\right]\iff\\
\epsilon & =\sigma_{c}\frac{\sqrt{12}}{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
and using the hint
\begin_inset Formula 
\[
\mathbb{E}\left[(1+\epsilon_{t})^{1-\gamma}\right]=\frac{1}{2\epsilon}\frac{1}{2-\gamma}\left[\left(1+\epsilon\right)^{2-\gamma}-\left(1-\epsilon\right)^{2-\gamma}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
we obtain the final expression for 
\begin_inset Formula $\lambda$
\end_inset

 as a function of parameters and the standard deviation of consumption:
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
The intepretation of 
\begin_inset Formula $\lambda$
\end_inset

 is the share of consumption that the consumer is willing to forego in order to not experience consumption fluctuations compared to the scenario where the they experience uniformly distributed fluctuations with standard deviation 
\begin_inset Formula $\sigma_{c}.$
\end_inset


\end_layout

\end_inset


\begin_inset Formula 
\begin{align*}
\lambda_{c} & =1-\left[\frac{1}{2\epsilon}\frac{1}{2-\gamma}\left[\left(1+\epsilon\right)^{2-\gamma}-\left(1-\epsilon\right)^{2-\gamma}\right]\right]^{1-\gamma}\\
 & =1-\left[\frac{1}{\sigma_{c}\sqrt{12}}\frac{1}{2-\gamma}\left[\left(1+\sigma_{c}\frac{\sqrt{12}}{2}\right)^{2-\gamma}-\left(1-\sigma_{c}\frac{\sqrt{12}}{2}\right)^{2-\gamma}\right]\right]^{1-\gamma}.
\end{align*}

\end_inset


\end_layout

