\begin_layout Section
MPC with infinite horizon
\end_layout

\begin_layout Subsection
a)
\end_layout

\begin_layout Subsubsection
Bellman equation
\end_layout

\begin_layout Standard
The (representative) consumer faces the following utility maximization problem
\begin_inset Formula 
\begin{align*}
\max_{c_{t},a_{t+1}\forall t}U_{t} & \equiv\sum^{\infty}_{k=0}\beta^{t+k}\frac{c^{1-\sigma}_{t+k}}{1-\sigma}\\
s.t.\\
c_{t}+a_{t+1} & =y_{t}+(1+r)a_{t}
\end{align*}

\end_inset


\begin_inset Formula 
\[
\lim_{T\rightarrow\infty}\left(\prod^{T}_{t=0}(1+r)^{-1}\right)a_{T+1}\geq0,
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $a_{0}$
\end_inset

 is given and 
\begin_inset Formula $\sigma>1$
\end_inset

.
 First I derive the Bellman equation explicitely:
\begin_inset Formula 
\begin{align*}
V(a_{t}) & \equiv\max_{\{c_{t+k},a_{t+1+k}\}^{\infty}_{k=0}}\underbrace{\left\{ \sum^{\infty}_{k=0}\beta^{k}\frac{c^{1-\sigma}_{t+k}}{1-\sigma}\right\} }_{U_{t}}\\
 & =\max_{\{c_{t+k},a_{t+1+k}\}^{\infty}_{k=0}}\left\{ \frac{c^{1-\sigma}_{t}}{1-\sigma}+\beta\sum^{\infty}_{k=0}\beta^{k}\frac{c^{1-\sigma}_{t+1+k}}{1-\sigma}\right\} \\
 & =\max_{c_{t},a_{t+1}}\left\{ \frac{c^{1-\sigma}_{t}}{1-\sigma}+\beta V(a_{t+1})\right\} \\
 & =\max_{a_{t+1}}\left\{ \frac{\left(y_{t}+(1+r)a_{t}-a_{t+1}\right)^{1-\sigma}}{1-\sigma}+\beta V(a_{t+1})\right\} 
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The first order condition for an internal optima (for the right hand side) is given by
\begin_inset Formula 
\begin{equation}
\underbrace{\left(y_{t}+(1+r)a_{t}-a_{t+1}\right)^{-\sigma}}_{c_{t}}=\beta V_{a}(a_{t+1}),\label{eq:foc}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
where we have defined 
\begin_inset Formula $V_{a}(a_{t})\equiv\frac{\partial V}{\partial a_{t}}$
\end_inset

.
 By the envelope theorem (assuming 
\begin_inset Formula $V$
\end_inset

 is differentiable) we have
\begin_inset Formula 
\begin{equation}
V_{a}(a_{t+1})=(1+r)c^{-\sigma}_{t+1}.\label{eq:envelope}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection

\series bold
Proof of envelope theorem
\end_layout

\begin_layout Standard
Define the optimal asset policy 
\begin_inset Formula $a^{*}_{t+1}=g(a_{t})$
\end_inset

 as the function that solves the Bellman equation:
\begin_inset Formula 
\[
V(a_{t})=u\left(y_{t}+(1+r)a_{t}-g(a_{t})\right)+\beta V\left(g(a_{t})\right)
\]

\end_inset


\end_layout

\begin_layout Standard
differentiating wrt.
 
\begin_inset Formula $a_{t}$
\end_inset

 yields
\begin_inset Formula 
\begin{align*}
V_{a}(a_{t}) & =\underbrace{u'(c_{t})\left((1+r)-g'(a_{t})\right)}_{\text{gain due to increased current consumption}}+\underbrace{\beta V_{a}\left(g(a_{t})\right)g'(a_{t})}_{\text{gain due to increased savings}}\\
 & =(1+r)u'(c_{t})+g'(a)\underbrace{\left(\beta V_{a}\left(g(a_{t})\right)-u'(c_{t})\right)}_{=0\text{ (because of FOC)}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Q.E.D.
 
\end_layout

\begin_layout Standard
Intuitively 
\begin_inset Formula $\left(\beta V_{a}\left(g(a_{t})\right)-u'(c_{t})\right)=0$
\end_inset

 because the margianl gain of spending is equal the marginal gain of saving at the maximum.
 therefore shifting this a little bit does not matter for the value function.
 So basically the increase in assets is distributed as utility gain due to increased current consumption and increased future savings,
 but disregarding the distribution over current and future consumption as this gives the same marginal utility at the maximum,
 which is 
\begin_inset Formula $(1+r)u'(c_{t})$
\end_inset

.
\end_layout

\begin_layout Subsubsection
The Euler equation
\end_layout

\begin_layout Standard
Combining 
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
eqref{eq:foc}
\end_layout

\end_inset

 and 
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
eqref{eq:envelope}
\end_layout

\end_inset

 we obtain the well known Euler equation
\begin_inset Formula 
\begin{equation}
c^{-\sigma}_{t}=\beta(1+r)c^{-\sigma}_{t+1},\label{eq:euler}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
which is a nessesary condition for an internal optimal consumption path.
\end_layout

\begin_layout Subsection
b)
\end_layout

\begin_layout Subsubsection
Transversality condition
\end_layout

\begin_layout Standard
From the maximization problem we have the no ponzi-scheme condition
\begin_inset Formula 
\[
\lim_{T\rightarrow\infty}\left(\prod^{T}_{t=0}(1+r)^{-1}\right)a_{T+1}=\lim_{T\rightarrow\infty}\left((1+r)^{-(T+1)}\right)a_{T+1}\geq0,
\]

\end_inset


\end_layout

\begin_layout Standard
Because the utility function is monotone in consumption
\begin_inset Formula 
\[
\frac{\partial U_{t}}{\partial c_{t+k}}>0,\quad\forall k\geq0,
\]

\end_inset


\end_layout

\begin_layout Standard
and the consumer gains no direct utility from assets
\begin_inset Formula 
\[
\frac{\partial U_{t}}{\partial a_{t+k}}=0,\quad\forall k\geq0,
\]

\end_inset


\end_layout

\begin_layout Standard
we conclude that the consumer would not increase savings indefinitely,
 and such the transversality condition is born
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\lim_{T\rightarrow\infty}\left((1+r)^{-(T+1)}\right)a_{T+1}=0.\label{eq:transversality}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Budget constraint
\end_layout

\begin_layout Standard
Iterating forward the budget constraint yields
\begin_inset Formula 
\begin{align*}
a_{t} & =(1+r)^{-1}\left(c_{t}-y_{t}\right)+(1+r)^{-1}a_{t+1}\\
 & =(1+r)^{-1}\left(c_{t}-y_{t}\right)+(1+r)^{-1}\left((1+r)^{-1}\left(c_{t+1}-y_{t+1}\right)+(1+r)^{-1}a_{t+2}\right)\\
 & =(1+r)^{-1}\left(c_{t}-y_{t}\right)+(1+r)^{-2}\left(c_{t+1}-y_{t+1}\right)+(1+r)^{-2}a_{t+2}\\
 & =(1+r)^{-1}\left(c_{t}-y_{t}\right)+(1+r)^{-1}+(1+r)^{-2}\left(c_{t+1}-y_{t+1}\right)+(1+r)^{-3}\left(c_{t+2}-y_{t+2}\right)+(1+r)^{-3}a_{t+3}\\
 & =\sum^{T}_{k=0}(1+r)^{-(k+1)}\left(c_{t+k}-y_{t+k}\right)+(1+r)^{-(T+1)}a_{T+1}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Taking the limit 
\begin_inset Formula $T\rightarrow\infty$
\end_inset

,
 evaluating at the starting period 
\begin_inset Formula $t=0$
\end_inset

 and using 
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
eqref{eq:transversality}
\end_layout

\end_inset

 yields
\begin_inset Formula 
\begin{align*}
a_{0} & =\sum^{\infty}_{k=0}(1+r)^{-(k+1)}\left(c_{t+k}-y_{t+k}\right)+\lim_{T\rightarrow\infty}(1+r)^{-(T+1)}a_{T+1}\\
 & =\sum^{\infty}_{k=0}(1+r)^{-(k+1)}\left(c_{t+k}-y_{t+k}\right)\iff\\
\sum^{\infty}_{k=0}(1+r)^{-k}c_{t+k} & =(1+r)a_{0}+h_{0},
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $h_{0}\equiv\sum^{\infty}_{k=0}(1+r)^{-k}y_{t+k}$
\end_inset

 is the present value of human capital / income stream.
 That is the present value of consumption is equal to the value of period-0 assets and the present value of income.
\end_layout

